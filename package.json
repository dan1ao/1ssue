{
  "name": "1ssue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "lerna run build",
    "beta-version": "lerna version --conventional-commits --conventional-prerelease --preid next --yes",
    "beta-publish": "lerna publish from-git --dist-tag next --yes",
    "beta": "pnpm run build && pnpm run beta-version && pnpm run beta-publish",
    "release-version": "lerna version --conventional-commits --conventional-graduate --yes",
    "release-publish": "lerna publish from-git --yes",
    "release": "pnpm run build && pnpm run beta-version && pnpm run beta-publish"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@eslint/js": "^9.39.4",
    "@lerna-lite/cli": "^4.11.5",
    "@lerna-lite/publish": "^4.11.5",
    "@lerna-lite/run": "^4.11.5",
    "@lerna-lite/version": "^4.11.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "catalog:",
    "conventional-changelog-conventionalcommits": "^9.3.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.57.0"
  },
  "browserslist": [
    "last 2 years and not dead"
  ],
  "packageManager": "pnpm@10.32.1"
