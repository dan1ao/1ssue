{
  "$schema": "node_modules/@lerna-lite/cli/schemas/lerna-schema.json",
  "version": "independent",
  "packages": ["packages/config/*", "packages/utils/*"],
  "npmClient": "pnpm",
  "command": {
    "version": {
      "conventionalCommits": true,
      "allowBranch": ["release", "next"],
      "message": "chore: publish new version"
    },
    "publish": {
      "stripPackageKeys": ["devDependencies", "scripts"]
    }
  },
  "changelogPreset": "conventionalcommits",
  "ignoreChanges": ["**/*.md"]
}
